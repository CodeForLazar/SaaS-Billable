# Copy this file to .env and fill in the values: cp .env.example .env
# .env is git-ignored. This file is committed so everyone knows which variables exist.

# --- Database -----------------------------------------------------------------
# Local: the Postgres container from docker-compose.yml
# Production: the connection string from Neon / Supabase
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_app"

# --- Auth (Better Auth) -------------------------------------------------------
# Secret used to sign cookies and tokens. At least 32 chars. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-random-32+-char-secret"
# Public base URL of the app (production: https://your-domain.com)
BETTER_AUTH_URL="http://localhost:3000"

# --- Email (SMTP via Nodemailer) ----------------------------------------------
# Local: Mailpit from docker-compose.yml (no auth, no TLS). Inbox: http://localhost:8025
# Production: your SMTP provider (Brevo, SES, Mailgun, ...), usually port 587 or 465
SMTP_HOST="localhost"
SMTP_PORT="1025"
# "true" for port 465 (TLS from the start); "false" for 587/1025 (STARTTLS or plain)
SMTP_SECURE="false"
# Leave empty when the server needs no login (Mailpit)
SMTP_USER=""
SMTP_PASS=""
# Sender shown to recipients
MAIL_FROM="Client Portal <no-reply@example.com>"

# --- Stripe (payments), test mode. Dashboard > Developers > API keys: the SECRET key (sk_test_...).
# The publishable key isn't needed: payments happen on Stripe's hosted Checkout page.
STRIPE_SECRET_KEY="sk_test_..."
# Signs webhook calls so we can check they come from Stripe. Locally: `stripe listen --print-secret`
# (then run `stripe listen --forward-to localhost:3000/api/stripe/webhook` while testing).
# In production: the endpoint's signing secret in Dashboard > Developers > Webhooks.
STRIPE_WEBHOOK_SECRET="whsec_..."
