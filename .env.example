# Copy this file to .env and fill in the values: cp .env.example .env
# .env is git-ignored. This file is committed so everyone knows which variables exist.

# --- Database -----------------------------------------------------------------
# Local: the Postgres container from docker-compose.yml
# Production: the connection string from Neon / Supabase
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_app"

# --- Auth (Better Auth) -------------------------------------------------------
# Secret used to sign cookies and tokens. At least 32 chars. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-random-32+-char-secret"
# Public base URL of the app (production: https://your-domain.com)
BETTER_AUTH_URL="http://localhost:3000"
