// Time someone worked on a project. A running timer is an entry without an end.
model TimeEntry {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String
  // Composite foreign key, like Project -> Client: the project must be in the SAME workspace.
  // Restrict: a project with time can't be deleted (it's archived instead).
  project   Project @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)

  userId String
  // Restrict: tracked (and later invoiced) time must not vanish with a user account.
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  description String? // what was done; shown on invoices
  startedAt   DateTime // stored in UTC, like every DateTime here
  endedAt     DateTime? // null = the timer is still running
  durationSec Int? // endedAt - startedAt in seconds, stored so reports can simply SUM it; null while running
  billable    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One running timer per user, across all workspaces: a partial unique index, so the database
  // itself rejects a second entry with endedAt = null for the same user (even with two tabs racing).
  // Two more rules are CHECK constraints in the migration (Prisma's schema can't express them):
  // endedAt >= startedAt, and durationSec is set exactly when endedAt is.
  @@unique([userId], where: raw("\"endedAt\" IS NULL"), map: "time_entry_one_running_timer_per_user")
  @@index([organizationId, startedAt]) // a workspace's time in a date range (timesheet, reports)
  @@index([userId, startedAt]) // one person's time
  @@index([projectId])
  @@map("time_entry")
}
